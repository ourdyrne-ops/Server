DATABASE_URL=postgresql://postgres:postgres@localhost:5432/melcome_db

# Telegram Bot & Stars Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PAYMENT_INVOICE_MODE=sendInvoice # sendInvoice | createInvoiceLink
TELEGRAM_STARS_MONTHLY_AMOUNT=500 # Configurable integer Stars amount (e.g. 500 or 100)
TELEGRAM_STARS_MODE=production # production | test

# Authentication & Sessions
JWT_SECRET=
SESSION_SECRET=
ADMIN_SECRET=

# Storage & Media Delivery
MEDIA_STORAGE_PATH=./uploads
MEDIA_SIGNING_SECRET=generate_a_secure_media_signing_secret_here

# Protected Video Streaming & Key Encryption
STREAMING_TOKEN_SECRET=generate_a_secure_token_secret_for_hls_stream_here
MEDIA_STORAGE_TYPE=local # local | s3
LOCAL_STORAGE_PATH=./storage

# S3 Compatible Object Storage (Alternative to archived MinIO: Garage S3, SeaweedFS, Cloudflare R2)
S3_ENDPOINT=https://s3.example.com
S3_BUCKET_RAW=tele-raw-media
S3_BUCKET_HLS=tele-hls-media
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Sales Agent Bot Configuration (Separate Bot Token for Course Sales)
SALES_BOT_TOKEN=
SALES_BOT_USERNAME=melcome_sales_bot
SERVICE_BOT_USERNAME=melcome_university_bot
